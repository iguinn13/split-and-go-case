{
    "name": "split-and-go",
    "version": "0.0.0",
    "private": true,
    "description": "Group expense splitting platform with minimal-transfer settlement",
    "packageManager": "pnpm@12.4.1",
    "engines": {
        "node": ">=24.0.0 <25",
        "pnpm": ">=12"
    },
    "scripts": {
        "lint": "eslint . --max-warnings 0 && pnpm -r --if-present lint",
        "format": "prettier --write . && pnpm -r --if-present format",
        "format:check": "prettier --check .",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "pnpm -r --if-present test",
        "build": "pnpm -r --if-present build",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,tsx}": [
            "eslint --fix --max-warnings 0",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": "prettier --write"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1"
    }
}
