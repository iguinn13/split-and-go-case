# PostgreSQL connection string (required)
DATABASE_URL=postgresql://splitgo:splitgo@localhost:5432/splitgo
# Secret used to sign JWTs. Use a long random value outside local development.
JWT_SECRET=change-me-in-development-only
# HTTP port of the API
PORT=3001
# Origin allowed by CORS (the web app URL)
CORS_ORIGIN=http://localhost:3000
# Exchange rate provider (Frankfurter / ECB rates)
FX_PROVIDER_URL=https://api.frankfurter.dev/v1
