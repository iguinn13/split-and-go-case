# Production template. Copy to `.env` ON THE SERVER (never commit the real file).
# scripts/deploy generates the secrets automatically when `.env` does not exist.

# Public domain served by nginx (DNS must point to the server)
DOMAIN=example.duckdns.org
# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=you@example.com

POSTGRES_USER=splitgo
POSTGRES_DB=splitgo
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 48
JWT_SECRET=

FX_PROVIDER_URL=https://api.frankfurter.dev/v1
