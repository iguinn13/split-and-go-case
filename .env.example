# Used by `docker compose up`. Copy to .env and adjust.

# PostgreSQL container
POSTGRES_USER=splitgo
POSTGRES_PASSWORD=splitgo
POSTGRES_DB=splitgo

# Secret used to sign JWTs. Use a long random value outside local development.
JWT_SECRET=change-me-in-development-only

# Origin allowed by the API CORS policy (the web app URL)
CORS_ORIGIN=http://localhost:3000

# Exchange rate provider (default: Frankfurter / ECB rates)
FX_PROVIDER_URL=https://api.frankfurter.dev/v1

# Optional host ports (defaults shown)
# POSTGRES_PORT=5432
# API_PORT=3001
# WEB_PORT=3000

# Note: DATABASE_URL (API) and API_URL (web) are set by docker-compose.yml.
# For running without Docker see apps/api/.env.example and apps/web/.env.example.
